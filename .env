# Ollama (only needed if a profile uses Ollama)
OLLAMA_HOST=http://localhost:11434

# Active Profile — selects which system/profiles/*.json file to load
# Available presets: coder-v2, local-only, power-inspector
ACTIVE_PROFILE=coder-v2

# Session Refresh Thresholds
SESSION_MAX_TURNS=20
REFRESH_ON_ARCH_SWITCH=false

# Architecture Layers (comma-separated, for arch-switch refresh trigger)
ARCH_LAYERS=

# Future: Model routing by diff size (not active yet)
REVIEWER_ROUTING_ENABLED=false

