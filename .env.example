# API Keys for CLIs

# Gemini API Key (if required by your Gemini CLI wrapper)
GEMINI_API_KEY=""

# Anthropic API Key (required for Claude CLI or API Mode)
ANTHROPIC_API_KEY=""

# Set to true to use SDKs with real prompt caching. Set to false for CLI subprocess mode.
USE_API_MODE=false

# Any other necessary environment variables
# OLLAMA_HOST="http://localhost:11434"
